{
  "name": "@sanity/visual-editing-standalone",
  "version": "1.1.0",
  "description": "Self-contained ESM build of Sanity Visual Editing for non-React applications",
  "keywords": [
    "esm",
    "overlays",
    "presentation",
    "preview",
    "sanity.io",
    "visual-editing"
  ],
  "homepage": "https://github.com/sanity-io/visual-editing/tree/main/packages/visual-editing-standalone#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/visual-editing/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/visual-editing.git",
    "directory": "packages/visual-editing-standalone"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": {
      "types": "./dist/style-css.d.ts",
      "browser": "./dist/style.css",
      "style": "./dist/style.css",
      "node": "./dist/style-css.js",
      "default": "./dist/style-css.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "prepack": "turbo run build",
    "test": "vitest --typecheck"
  },
  "devDependencies": {
    "@sanity/client": "catalog:",
    "@sanity/tsconfig": "catalog:",
    "@sanity/tsdown-config": "^0.24.1",
    "@sanity/visual-editing": "workspace:*",
    "@tsdown/css": "^0.22.14",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19"
  },
  "inlinedDependencies": {
    "@floating-ui/core": "1.8.0",
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/react-dom": "2.1.9",
    "@floating-ui/utils": "0.2.12",
    "@sanity/client": "7.26.2",
    "@sanity/color": "3.0.8",
    "@sanity/comlink": "4.0.3",
    "@sanity/diff-match-patch": "3.2.0",
    "@sanity/icons": "5.2.1",
    "@sanity/mutate": "0.18.1",
    "@sanity/presentation-comlink": "2.2.3",
    "@sanity/types": "6.9.2",
    "@sanity/ui": "4.0.2",
    "@vercel/stega": "1.1.0",
    "compute-scroll-into-view": "3.1.1",
    "framer-motion": "13.1.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "mendoza": "3.0.8",
    "motion": "13.1.0",
    "motion-dom": "13.0.0",
    "motion-utils": "13.0.0",
    "nanoid": "5.1.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "rxjs": "7.8.2",
    "scheduler": "0.27.0",
    "scroll-into-view-if-needed": "3.1.0",
    "styled-components": "6.5.2",
    "stylis": "4.3.6",
    "tslib": "2.8.1",
    "use-effect-event": "2.0.3",
    "uuid": [
      "11.1.1",
      "14.0.1"
    ],
    "valibot": "1.4.2",
    "xstate": "5.32.5"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./style.css": {
        "types": "./dist/style-css.d.ts",
        "browser": "./dist/style.css",
        "style": "./dist/style.css",
        "node": "./dist/style-css.js",
        "default": "./dist/style-css.js"
      },
      "./package.json": "./package.json"
    }
  }
}
