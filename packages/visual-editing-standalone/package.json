{
  "name": "@sanity/visual-editing-standalone",
  "version": "2.0.1",
  "description": "Self-contained ESM build of Sanity Visual Editing for non-React applications",
  "keywords": [
    "esm",
    "overlays",
    "presentation",
    "preview",
    "sanity.io",
    "visual-editing"
  ],
  "homepage": "https://github.com/sanity-io/visual-editing/tree/main/packages/visual-editing-standalone#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/visual-editing/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/visual-editing.git",
    "directory": "packages/visual-editing-standalone"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "prepack": "turbo run build",
    "test": "vitest --typecheck"
  },
  "devDependencies": {
    "@sanity/client": "catalog:",
    "@sanity/tsconfig": "catalog:",
    "@sanity/tsdown-config": "^0.28.1",
    "@sanity/visual-editing": "workspace:*",
    "@tsdown/css": "^0.23.0",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19"
  },
  "inlinedDependencies": {
    "@floating-ui/core": "1.8.0",
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/react-dom": "2.1.9",
    "@floating-ui/utils": "0.2.12",
    "@sanity/client": "8.6.2",
    "@sanity/color": "3.0.8",
    "@sanity/comlink": "4.0.3",
    "@sanity/diff-match-patch": "3.2.0",
    "@sanity/icons": "5.2.2",
    "@sanity/mutate": "0.18.2",
    "@sanity/presentation-comlink": "2.2.3",
    "@sanity/types": "6.15.0",
    "@sanity/ui": "4.2.1",
    "@vanilla-extract/dynamic": "2.1.5",
    "@vanilla-extract/private": "1.0.9",
    "@vercel/stega": "1.1.0",
    "clsx": "2.1.1",
    "compute-scroll-into-view": "3.1.1",
    "framer-motion": "13.4.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "mendoza": "3.0.8",
    "motion": "13.4.0",
    "motion-dom": "13.3.0",
    "motion-utils": "13.3.0",
    "nanoid": "5.1.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "rxjs": "7.8.2",
    "scheduler": "0.28.0",
    "scroll-into-view-if-needed": "3.1.0",
    "styled-components": "6.5.3",
    "stylis": "4.3.6",
    "tslib": "2.8.1",
    "use-effect-event": "2.0.4",
    "uuid": [
      "11.1.1",
      "14.0.2"
    ],
    "valibot": "1.5.0",
    "xstate": "5.33.2"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "default": "./dist/styles.css"
      },
      "./package.json": "./package.json"
    }
  }
}
