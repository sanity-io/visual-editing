{
  "name": "@sanity/core-loader",
  "version": "2.1.4",
  "homepage": "https://github.com/sanity-io/visual-editing/tree/main/packages/core-loader#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/visual-editing/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/visual-editing.git",
    "directory": "packages/core-loader"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./create-data-attribute": {
      "source": "./src/createDataAttribute.ts",
      "import": "./dist/create-data-attribute.js",
      "require": "./dist/create-data-attribute.cjs",
      "default": "./dist/create-data-attribute.js"
    },
    "./encode-data-attribute": {
      "source": "./src/encodeDataAttribute.ts",
      "import": "./dist/encode-data-attribute.js",
      "require": "./dist/encode-data-attribute.cjs",
      "default": "./dist/encode-data-attribute.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./create-data-attribute": {
        "import": "./dist/create-data-attribute.js",
        "require": "./dist/create-data-attribute.cjs",
        "default": "./dist/create-data-attribute.js"
      },
      "./encode-data-attribute": {
        "import": "./dist/encode-data-attribute.js",
        "require": "./dist/encode-data-attribute.cjs",
        "default": "./dist/encode-data-attribute.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pkg build --strict --check --clean",
    "dev": "pkg build --strict",
    "prepack": "turbo run build",
    "test": "vitest --pass-with-no-tests --typecheck"
  },
  "dependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/comlink": "^4.0.3",
    "@sanity/presentation-comlink": "^2.2.3",
    "@sanity/visual-editing-csm": "workspace:^",
    "@sanity/visual-editing-types": "workspace:^"
  },
  "devDependencies": {
    "@repo/package.config": "workspace:*",
    "@sanity/client-v8": "npm:@sanity/client@^8.0.0",
    "@sanity/pkg-utils": "catalog:",
    "@sanity/preview-url-secret": "workspace:^",
    "@sanity/tsconfig": "catalog:",
    "async-cache-dedupe": "2.2.0",
    "happy-dom": "^18.0.1",
    "nanostores": "1.0.1",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=18"
  },
  "inlinedDependencies": {
    "async-cache-dedupe": "2.2.0",
    "mnemonist": "0.39.8",
    "nanostores": "1.0.1",
    "obliterator": "2.0.5",
    "safe-stable-stringify": "2.5.0"
  }
}
